+/* The browser answers before the first finger arrives whether this is a touch-first device (a phone or a tablet), so
+ * the race can show its on-screen controls from the first frame instead of waiting for a tap. */
+EM_JS(int, web_touch_device, (), {
+    try {
+        if (navigator.maxTouchPoints > 0) return 1;
+        if (window.matchMedia && window.matchMedia('(pointer: coarse)').matches) return 1;
+    } catch (e) {}
+    return 0;
+});
+
+/* A message box does not exist in the page: the shell listens for this event and shows the text above the game. */
+EM_JS(void, web_message, (const char *text), {
+    var s = UTF8ToString(text);
+    console.error('A2RacerIIRE: ' + s);
+    try { window.dispatchEvent(new CustomEvent('a2-message', { detail: s })); } catch (e) {}
+});
+#endif
 
