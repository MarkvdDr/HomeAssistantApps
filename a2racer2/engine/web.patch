-void plat_swap(void) { SDL_GL_SwapWindow(g_win); }
+void plat_swap(void)
+{
+    SDL_GL_SwapWindow(g_win);
+#ifdef __EMSCRIPTEN__
+    /* The browser's swap does not wait for the screen. Yield to the event loop until the next 60 Hz deadline, so the
+     * page keeps handling input and the game settles near 60 frames per second. The game measures its own frame time,
+     * so its speed does not depend on this. */
+    static double next;
+    double now = plat_time();
+    if (next <= 0) next = now;
+    next += 1.0 / 60.0;
+    if (next < now + 0.001) next = now + 0.001;          /* a slow frame: do not build up a backlog */
+    int ms = (int)((next - now) * 1000.0);
+    emscripten_sleep(ms > 0 ? ms : 0);
+#endif
+}
 void plat_size(int *w, int *h) { SDL_GL_GetDrawableSize(g_win, w, h); }
